{
  "name": "family-lab-lis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "test:safety": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui-theme": "node scripts/check-ui-theme.mjs",
    "test:ui-i18n": "node scripts/check-ui-i18n.mjs",
    "ops:backup": "node scripts/operations/create-encrypted-backup.mjs create",
    "ops:backup:verify": "node scripts/operations/create-encrypted-backup.mjs verify",
    "ops:restore-isolated": "node scripts/operations/restore-isolated-backup.mjs restore-isolated",
    "f3:offline-intake": "node --experimental-strip-types scripts/f3-offline-intake.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "mysql2": "3.23.1",
    "bcryptjs": "3.0.2",
    "qrcode": "1.5.4",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "typescript": "^5",
    "@types/qrcode": "1.5.5"
  },
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "overrides": {
    "mysql2": "3.23.1",
    "deepmerge-ts": "8.0.0",
    "@typescript-eslint/type-utils": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/typescript-estree": "8.71.2",
    "@typescript-eslint/utils": "8.71.2",
    "@typescript-eslint/scope-manager": "8.71.2",
    "@typescript-eslint/visitor-keys": "8.71.2",
    "@typescript-eslint/project-service": "8.71.2",
    "@typescript-eslint/tsconfig-utils": "8.71.2",
    "typescript-eslint": "8.71.2"
  }
}
