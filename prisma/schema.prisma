  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([scope, keyHash])
  @@index([updatedAt])
  @@map("request_rate_limits")
}

model StaffStepUpGrant {
  id             String @id @default(uuid()) @db.Char(36)
  userId         String @map("user_id") @db.Char(36)
  sessionId      String @map("session_id") @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  branchId       String @map("branch_id") @db.Char(36)
  action         String @db.VarChar(40)
  resourceKey    String @map("resource_key") @db.VarChar(150)
  tokenHash      String @unique @map("token_hash") @db.Char(64)
  proofMethod    String @map("proof_method") @db.VarChar(40)
  expiresAt      DateTime @map("expires_at") @db.DateTime(3)
  consumedAt     DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  @@index([sessionId, createdAt], map:"ssug_session_created_idx")
  @@index([organizationId, branchId, action, expiresAt], map:"ssug_scope_expiry_idx")
  @@map("staff_step_up_grants")
}

model StaffStepUpAttempt {
  id        String @id @default(uuid()) @db.Char(36)
  userId    String @map("user_id") @db.Char(36)
  sessionId String @map("session_id") @db.Char(36)
  success   Boolean
