generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PatientSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PatientIdentifierType {
  NATIONAL_ID
  PASSPORT
  OTHER
}

enum ClientType {
  INDIVIDUAL
  CLINIC
  HOSPITAL
  COMPANY
  INSURANCE
  OTHER
}

enum ReferrerType {
  PHYSICIAN
  CLINIC
  HOSPITAL
  OTHER
}

enum OrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum OrderStatus {
  DRAFT
  REGISTERED
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  ORDERED
  COLLECTED
  IN_PROGRESS
  RESULTED
  VERIFIED
  CANCELLED
}

enum PriceListScope {
  ORGANIZATION
  BRANCH
  CLIENT
  CONTRACT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  CREDITED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CREDIT_ACCOUNT
  OTHER
}

enum PaymentStatus {
  POSTED
  VOIDED
  REFUNDED
}

enum SpecimenStatus {
  PLANNED
  COLLECTED
  RECEIVED
  IN_TRANSIT
  IN_PROCESS
  REJECTED
  DISPOSED
}

enum SpecimenEventType {
  CREATED
  COLLECTED
  RECEIVED
  REJECTED
  RELOCATED
  TRANSFERRED
  PROCESSING_STARTED
  DISPOSED
}

model Organization {
  id              String       @id @default(uuid()) @db.Char(36)
  code            String       @unique @db.VarChar(50)
  nameEn          String       @map("name_en") @db.VarChar(200)
  nameAr          String?      @map("name_ar") @db.VarChar(200)
  legalName       String?      @map("legal_name") @db.VarChar(255)
  defaultCurrency String       @default("AED") @map("default_currency") @db.Char(3)
  defaultTimezone String       @default("Asia/Dubai") @map("default_timezone") @db.VarChar(64)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt   DateTime?    @map("deactivated_at") @db.DateTime(3)

  branches    Branch[]
  users       User[]
  roles       Role[]
  departments Department[]
  auditEvents AuditEvent[]
  specimenTypes SpecimenType[]
  containers Container[]
  units Unit[]
  methods Method[]
  labTests LabTest[]
  testPanels TestPanel[]
  catalogImportBatches CatalogImportBatch[]
  catalogImportMappings CatalogImportMapping[]
  patients Patient[]
  patientIdentifiers PatientIdentifier[]
  clients Client[]
  referrers Referrer[]
  contracts Contract[]
  priceLists PriceList[]
  orders LabOrder[]
  invoices Invoice[]
  payments Payment[]
  specimens Specimen[]

  @@map("organizations")
}

model Branch {
  id              String       @id @default(uuid()) @db.Char(36)
  organizationId  String       @map("organization_id") @db.Char(36)
  code            String       @db.VarChar(50)
  nameEn          String       @map("name_en") @db.VarChar(200)
  nameAr          String?      @map("name_ar") @db.VarChar(200)
  timezone        String       @default("Asia/Dubai") @db.VarChar(64)
  defaultCurrency String       @default("AED") @map("default_currency") @db.Char(3)
  phone           String?      @db.VarChar(50)
  email           String?      @db.VarChar(191)
  addressEn       String?      @map("address_en") @db.Text
  addressAr       String?      @map("address_ar") @db.Text
  isCentralLab    Boolean      @default(false) @map("is_central_lab")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt   DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  settings     BranchSetting[]
  departments Department[]
  workstations Workstation[]
  userScopes   UserBranchScope[]
  auditEvents  AuditEvent[]
  activeSessions UserSession[] @relation("ActiveBranchSessions")
  testAvailability TestBranchAvailability[]
  referenceIntervals ReferenceInterval[]
  priceLists PriceList[]
  orders LabOrder[] @relation("OrderingBranchOrders")
  performedOrderItems OrderItem[] @relation("PerformedBranchOrderItems")
  invoices Invoice[]
  payments Payment[]
  collectedSpecimens Specimen[] @relation("SpecimenCollectionBranch")
  currentSpecimens Specimen[] @relation("SpecimenCurrentBranch")
  specimenEvents SpecimenEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("branches")
}

model BranchSetting {
  id        String   @id @default(uuid()) @db.Char(36)
  branchId  String   @map("branch_id") @db.Char(36)
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, key])
  @@map("branch_settings")
}

model Department {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  branchId       String?      @map("branch_id") @db.Char(36)
  code           String       @db.VarChar(50)
  nameEn         String       @map("name_en") @db.VarChar(150)
  nameAr         String?      @map("name_ar") @db.VarChar(150)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  workstations Workstation[]
  userScopes   UserDepartmentScope[]
  labTests      LabTest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([branchId, status])
  @@map("departments")
}

model Workstation {
  id           String       @id @default(uuid()) @db.Char(36)
  branchId     String       @map("branch_id") @db.Char(36)
  departmentId String?      @map("department_id") @db.Char(36)
  code         String       @db.VarChar(50)
  nameEn       String       @map("name_en") @db.VarChar(150)
  nameAr       String?      @map("name_ar") @db.VarChar(150)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt DateTime?   @map("deactivated_at") @db.DateTime(3)

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([branchId, code])
  @@index([departmentId, status])
  @@map("workstations")
}

model User {
  id             String     @id @default(uuid()) @db.Char(36)
  organizationId String     @map("organization_id") @db.Char(36)
  username       String     @db.VarChar(100)
  email          String?    @db.VarChar(191)
  passwordHash   String?    @map("password_hash") @db.VarChar(255)
  displayNameEn  String     @map("display_name_en") @db.VarChar(200)
  displayNameAr  String?    @map("display_name_ar") @db.VarChar(200)
  preferredLocale String    @default("en") @map("preferred_locale") @db.VarChar(10)
  status         UserStatus @default(INVITED)
  lastLoginAt    DateTime?  @map("last_login_at") @db.DateTime(3)
  failedLoginAttempts Int    @default(0) @map("failed_login_attempts")
  lockedUntil     DateTime?  @map("locked_until") @db.DateTime(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.DateTime(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?  @map("deactivated_at") @db.DateTime(3)

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles            UserRole[]
  branchScopes     UserBranchScope[]
  departmentScopes UserDepartmentScope[]
  auditEvents      AuditEvent[]          @relation("AuditActor")
  sessions         UserSession[]
  approvedReferenceIntervals ReferenceInterval[] @relation("ReferenceIntervalApprover")
  createdCatalogImportMappings CatalogImportMapping[] @relation("CatalogImportMappingCreator")
  createdOrders LabOrder[] @relation("OrderCreator")
  createdInvoices Invoice[] @relation("InvoiceCreator")
  cashierPayments Payment[] @relation("PaymentCashier")
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChanger")
  collectedSpecimens Specimen[] @relation("SpecimenCollector")
  receivedSpecimens Specimen[] @relation("SpecimenReceiver")
  rejectedSpecimens Specimen[] @relation("SpecimenRejector")
  specimenEvents SpecimenEvent[] @relation("SpecimenEventActor")

  @@unique([organizationId, username])
  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(80)
  nameEn         String       @map("name_en") @db.VarChar(150)
  nameAr         String?      @map("name_ar") @db.VarChar(150)
  isSystem       Boolean      @default(false) @map("is_system")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(120)
  module      String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  assignedBy String?  @map("assigned_by") @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  grantedAt    DateTime @default(now()) @map("granted_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserBranchScope {
  userId    String   @map("user_id") @db.Char(36)
  branchId  String   @map("branch_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branch_scopes")
}

model UserDepartmentScope {
  userId       String   @map("user_id") @db.Char(36)
  departmentId String   @map("department_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_department_scopes")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  branchId       String?  @map("branch_id") @db.Char(36)
  actorUserId    String?  @map("actor_user_id") @db.Char(36)
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String   @map("entity_id") @db.VarChar(100)
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  reason         String?  @db.Text
  requestId      String?  @map("request_id") @db.VarChar(100)
  sessionId      String?  @map("session_id") @db.VarChar(100)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}

model UserSession {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  activeBranchId String?  @map("active_branch_id") @db.Char(36)
  tokenHash      String   @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime @map("expires_at") @db.DateTime(3)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.DateTime(3)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user         User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeBranch Branch? @relation("ActiveBranchSessions", fields: [activeBranchId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([activeBranchId])
  @@map("user_sessions")
}


enum ResultType {
  NUMERIC
  TEXT
  QUALITATIVE
  BOOLEAN
  DATE
}

enum SexApplicability {
  ANY
  MALE
  FEMALE
}

enum AgeUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum ImportBatchStatus {
  DRAFT
  VALIDATED
  IMPORTED
  FAILED
}

enum ImportRowStatus {
  PENDING
  VALID
  WARNING
  ERROR
  IMPORTED
  SKIPPED
}

enum CatalogImportMappingType {
  TEST_ALIAS
  UNIT_ALIAS
}

model SpecimenType {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(50)
  nameEn         String       @map("name_en") @db.VarChar(150)
  nameAr         String?      @map("name_ar") @db.VarChar(150)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tests        LabTest[]
  specimens    Specimen[]

  @@unique([organizationId, code])
  @@map("specimen_types")
}

model Container {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(50)
  nameEn         String       @map("name_en") @db.VarChar(150)
  nameAr         String?      @map("name_ar") @db.VarChar(150)
  tubeColor      String?      @map("tube_color") @db.VarChar(80)
  additive       String?      @db.VarChar(150)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tests        LabTest[]
  specimens    Specimen[]

  @@unique([organizationId, code])
  @@map("containers")
}

model Unit {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(50)
  symbol         String       @db.VarChar(50)
  nameEn         String?      @map("name_en") @db.VarChar(150)
  nameAr         String?      @map("name_ar") @db.VarChar(150)
  ucumCode       String?      @map("ucum_code") @db.VarChar(50)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tests        LabTest[]
  components   TestComponent[]
  importMappings CatalogImportMapping[]

  @@unique([organizationId, code])
  @@map("units")
}

model Method {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(50)
  nameEn         String       @map("name_en") @db.VarChar(150)
  nameAr         String?      @map("name_ar") @db.VarChar(150)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tests        LabTest[]
  referenceIntervals ReferenceInterval[]

  @@unique([organizationId, code])
  @@map("methods")
}

model LabTest {
  id                     String       @id @default(uuid()) @db.Char(36)
  organizationId         String       @map("organization_id") @db.Char(36)
  code                   String       @db.VarChar(80)
  nameEn                 String       @map("name_en") @db.VarChar(200)
  nameAr                 String?      @map("name_ar") @db.VarChar(200)
  abbreviation           String?      @db.VarChar(80)
  departmentId           String?      @map("department_id") @db.Char(36)
  specimenTypeId         String?      @map("specimen_type_id") @db.Char(36)
  containerId            String?      @map("container_id") @db.Char(36)
  methodId               String?      @map("method_id") @db.Char(36)
  defaultUnitId          String?      @map("default_unit_id") @db.Char(36)
  resultType             ResultType   @default(NUMERIC) @map("result_type")
  decimalPrecision       Int?         @map("decimal_precision")
  minimumVolume          Decimal?     @map("minimum_volume") @db.Decimal(10, 3)
  minimumVolumeUnit      String?      @map("minimum_volume_unit") @db.VarChar(30)
  collectionInstructions String?      @map("collection_instructions") @db.Text
  patientPreparation     String?      @map("patient_preparation") @db.Text
  storageConditions      String?      @map("storage_conditions") @db.Text
  stabilityMinutes       Int?         @map("stability_minutes")
  assay                  String?      @db.VarChar(200)
  tatMinutes             Int?         @map("tat_minutes")
  loincCode              String?      @map("loinc_code") @db.VarChar(30)
  status                 RecordStatus @default(ACTIVE)
  createdAt              DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt          DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  specimenType       SpecimenType? @relation(fields: [specimenTypeId], references: [id], onDelete: Restrict)
  container          Container? @relation(fields: [containerId], references: [id], onDelete: Restrict)
  method             Method? @relation(fields: [methodId], references: [id], onDelete: Restrict)
  defaultUnit        Unit? @relation(fields: [defaultUnitId], references: [id], onDelete: Restrict)
  components         TestComponent[]
  branchAvailability TestBranchAvailability[]
  panelItems         TestPanelItem[]
  importMappings     CatalogImportMapping[]
  priceListItems     PriceListItem[]
  orderItems         OrderItem[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([departmentId, status])
  @@map("lab_tests")
}

model TestComponent {
  id               String       @id @default(uuid()) @db.Char(36)
  testId           String       @map("test_id") @db.Char(36)
  code             String       @db.VarChar(80)
  nameEn           String       @map("name_en") @db.VarChar(200)
  nameAr           String?      @map("name_ar") @db.VarChar(200)
  unitId           String?      @map("unit_id") @db.Char(36)
  resultType       ResultType   @default(NUMERIC) @map("result_type")
  decimalPrecision Int?         @map("decimal_precision")
  displayOrder     Int          @default(0) @map("display_order")
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt    DateTime?    @map("deactivated_at") @db.DateTime(3)

  test               LabTest @relation(fields: [testId], references: [id], onDelete: Restrict)
  unit               Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  referenceIntervals ReferenceInterval[]

  @@unique([testId, code])
  @@index([testId, displayOrder])
  @@map("test_components")
}

model TestBranchAvailability {
  testId       String       @map("test_id") @db.Char(36)
  branchId     String       @map("branch_id") @db.Char(36)
  status       RecordStatus @default(ACTIVE)
  performedHere Boolean     @default(true) @map("performed_here")
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  test   LabTest @relation(fields: [testId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([testId, branchId])
  @@index([branchId, status])
  @@map("test_branch_availability")
}

model ReferenceInterval {
  id                String           @id @default(uuid()) @db.Char(36)
  componentId       String           @map("component_id") @db.Char(36)
  branchId          String?          @map("branch_id") @db.Char(36)
  methodId          String?          @map("method_id") @db.Char(36)
  sex               SexApplicability @default(ANY)
  ageFrom           Decimal?         @map("age_from") @db.Decimal(10, 3)
  ageTo             Decimal?         @map("age_to") @db.Decimal(10, 3)
  ageUnit           AgeUnit?         @map("age_unit")
  lowValue          Decimal?         @map("low_value") @db.Decimal(18, 6)
  highValue         Decimal?         @map("high_value") @db.Decimal(18, 6)
