model Role {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(80)
  nameEn         String       @map("name_en") @db.VarChar(150)
  nameAr         String?      @map("name_ar") @db.VarChar(150)
  isSystem       Boolean      @default(false) @map("is_system")
  discountLimitPercent Decimal @default(0) @map("discount_limit_percent") @db.Decimal(5, 2)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(120)
  module      String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  assignedBy String?  @map("assigned_by") @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  grantedAt    DateTime @default(now()) @map("granted_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserBranchScope {
