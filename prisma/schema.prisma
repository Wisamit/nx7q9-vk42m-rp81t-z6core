model OrganizationSetting {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @unique @map("organization_id") @db.Char(36)
  systemNameEn     String?  @map("system_name_en") @db.VarChar(200)
  systemNameAr     String?  @map("system_name_ar") @db.VarChar(200)
  logoDataUrl      String?  @map("logo_data_url") @db.MediumText
  faviconDataUrl   String?  @map("favicon_data_url") @db.MediumText
  defaultTheme     String   @default("SYSTEM") @map("default_theme") @db.VarChar(20)
  dateFormat       String   @default("DD/MM/YYYY") @map("date_format") @db.VarChar(40)
  timeFormat       String   @default("12") @map("time_format") @db.VarChar(10)
  showSeconds      Boolean  @default(false) @map("show_seconds")
  defaultLocale    String   @default("en") @map("default_locale") @db.VarChar(10)
  weekStartsOn     Int      @default(1) @map("week_starts_on")
  density          String   @default("COMFORTABLE") @db.VarChar(20)
  lightTheme       Json?    @map("light_theme")
  darkTheme        Json?    @map("dark_theme")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_settings")
}

model Branch {
  catalogConfigurationRevisions CatalogConfigurationRevision[]
  specimenRetentionPolicies SpecimenRetentionPolicy[]
  specimenDisposalCases SpecimenDisposalCase[]
  id              String       @id @default(uuid()) @db.Char(36)
  organizationId  String       @map("organization_id") @db.Char(36)
  code            String       @db.VarChar(50)
  nameEn          String       @map("name_en") @db.VarChar(200)
  nameAr          String?      @map("name_ar") @db.VarChar(200)
  timezone        String       @default("Africa/Cairo") @db.VarChar(64)
  defaultCurrency String       @default("EGP") @map("default_currency") @db.Char(3)
  phone           String?      @db.VarChar(50)
  email           String?      @db.VarChar(191)
  addressEn       String?      @map("address_en") @db.Text
  addressAr       String?      @map("address_ar") @db.Text
  isCentralLab    Boolean      @default(false) @map("is_central_lab")
  taxConfigVersion Int @default(0) @map("tax_config_version")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt   DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  specimenStorageLocations SpecimenStorageLocation[]
  settings     BranchSetting[]
  departments Department[]
  workstations Workstation[]
  analyzers Analyzer[]
  analyzerMessages AnalyzerMessage[]
  analyzerWorkOrders AnalyzerWorkOrder[]
  userScopes   UserBranchScope[]
  auditEvents  AuditEvent[]
  createdPatients Patient[] @relation("PatientCreationBranch")
  activeSessions UserSession[] @relation("ActiveBranchSessions")
  testAvailability TestBranchAvailability[]
  referenceIntervals ReferenceInterval[]
  tatPolicies TestTatPolicy[]
  priceLists PriceList[]
  orders LabOrder[] @relation("OrderingBranchOrders")
  doctorRequisitions DoctorRequisition[]
  orderClinicalNotes OrderClinicalNote[]
  performedOrderItems OrderItem[] @relation("PerformedBranchOrderItems")
  invoices Invoice[]
  discountApprovalRequests DiscountApprovalRequest[]
  payments Payment[]
  creditNotes CreditNote[]
  refunds Refund[]
  cashierShifts CashierShift[]
  clientAccountStatements ClientAccountStatement[]
  taxRules TaxRule[]
  collectedSpecimens Specimen[] @relation("SpecimenCollectionBranch")
  currentSpecimens Specimen[] @relation("SpecimenCurrentBranch")
  specimenEvents SpecimenEvent[]
  specimenUsageEvents SpecimenUsageEvent[]
  specimenCollectionAttempts SpecimenCollectionAttempt[]
  specimenReceptionAssessments SpecimenReceptionAssessment[]
  specimenRejections SpecimenRejection[]
  outgoingTransferManifests SpecimenTransferManifest[] @relation("TransferSourceBranch")
  incomingTransferManifests SpecimenTransferManifest[] @relation("TransferDestinationBranch")
  laboratoryResults LaboratoryResult[] @relation("ResultPerformingBranch")
