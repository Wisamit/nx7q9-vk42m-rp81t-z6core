  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(60)
  type           ClientType   @default(OTHER)
  nameEn         String       @map("name_en") @db.VarChar(220)
  nameAr         String?      @map("name_ar") @db.VarChar(220)
  phone          String?      @db.VarChar(50)
  email          String?      @db.VarChar(191)
  addressEn      String?      @map("address_en") @db.Text
  addressAr      String?      @map("address_ar") @db.Text
  paymentTermsDays Int?       @map("payment_terms_days")
