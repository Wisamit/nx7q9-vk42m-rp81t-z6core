model InventoryTransfer {
  id                  String                  @id @default(uuid()) @db.Char(36)
  organizationId      String                  @map("organization_id") @db.Char(36)
  transferNumber      String                  @map("transfer_number") @db.VarChar(80)
  sourceBranchId      String                  @map("source_branch_id") @db.Char(36)
  destinationBranchId String                  @map("destination_branch_id") @db.Char(36)
  status              InventoryTransferStatus @default(DRAFT)
  notes               String?                 @db.Text
  requestedByUserId   String                  @map("requested_by_user_id") @db.Char(36)
  requestedAt         DateTime                @default(now()) @map("requested_at") @db.DateTime(3)
  approvedByUserId    String?                 @map("approved_by_user_id") @db.Char(36)
  approvedAt          DateTime?               @map("approved_at") @db.DateTime(3)
  dispatchedByUserId  String?                 @map("dispatched_by_user_id") @db.Char(36)
  dispatchedAt        DateTime?               @map("dispatched_at") @db.DateTime(3)
  receivedByUserId    String?                 @map("received_by_user_id") @db.Char(36)
  receivedAt          DateTime?               @map("received_at") @db.DateTime(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceBranch      Branch       @relation("InventoryTransferSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch Branch       @relation("InventoryTransferDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  requestedBy       User         @relation("InventoryTransferRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?        @relation("InventoryTransferApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  dispatchedBy      User?        @relation("InventoryTransferDispatcher", fields: [dispatchedByUserId], references: [id], onDelete: Restrict)
  receivedBy        User?        @relation("InventoryTransferReceiver", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  items             InventoryTransferItem[]

  @@unique([organizationId, transferNumber])
  @@index([sourceBranchId, status, requestedAt])
  @@index([destinationBranchId, status, requestedAt])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id             String   @id @default(uuid()) @db.Char(36)
  transferId     String   @map("transfer_id") @db.Char(36)
  itemId         String   @map("item_id") @db.Char(36)
  lotId          String   @map("lot_id") @db.Char(36)
  requestedQty   Decimal  @map("requested_qty") @db.Decimal(18, 4)
  approvedQty    Decimal? @map("approved_qty") @db.Decimal(18, 4)
  dispatchedQty  Decimal? @map("dispatched_qty") @db.Decimal(18, 4)
  receivedQty    Decimal? @map("received_qty") @db.Decimal(18, 4)
  discrepancyQty Decimal? @map("discrepancy_qty") @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot      InventoryLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([transferId, lotId])
  @@index([itemId])
  @@map("inventory_transfer_items")
}

model PurchaseRequest {
  id                String                @id @default(uuid()) @db.Char(36)
  organizationId    String                @map("organization_id") @db.Char(36)
  branchId          String                @map("branch_id") @db.Char(36)
  requestNumber     String                @map("request_number") @db.VarChar(80)
  status            PurchaseRequestStatus @default(DRAFT)
  notes             String?               @db.Text
  requestedByUserId String                @map("requested_by_user_id") @db.Char(36)
  requestedAt       DateTime              @default(now()) @map("requested_at") @db.DateTime(3)
  approvedByUserId  String?               @map("approved_by_user_id") @db.Char(36)
  approvedAt        DateTime?             @map("approved_at") @db.DateTime(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("PurchaseRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("PurchaseRequestApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  items        PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, requestNumber])
  @@index([branchId, status, requestedAt])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                 String   @id @default(uuid()) @db.Char(36)
  purchaseRequestId  String   @map("purchase_request_id") @db.Char(36)
  itemId             String   @map("item_id") @db.Char(36)
  requestedQty       Decimal  @map("requested_qty") @db.Decimal(18, 4)
  estimatedUnitCost  Decimal? @map("estimated_unit_cost") @db.Decimal(18, 4)
  currency           String?  @db.Char(3)
  notes              String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  item            InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([purchaseRequestId, itemId])
  @@index([itemId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Char(36)
  organizationId    String              @map("organization_id") @db.Char(36)
  branchId          String              @map("branch_id") @db.Char(36)
  supplierId        String              @map("supplier_id") @db.Char(36)
  purchaseRequestId String?             @map("purchase_request_id") @db.Char(36)
  poNumber          String              @map("po_number") @db.VarChar(80)
  status            PurchaseOrderStatus @default(DRAFT)
  currency          String              @db.Char(3)
  supplierReference String?             @map("supplier_reference") @db.VarChar(150)
  orderedAt         DateTime?           @map("ordered_at") @db.DateTime(3)
  expectedAt        DateTime?           @map("expected_at") @db.DateTime(3)
  createdByUserId   String              @map("created_by_user_id") @db.Char(36)
  approvedByUserId  String?             @map("approved_by_user_id") @db.Char(36)
  approvedAt        DateTime?           @map("approved_at") @db.DateTime(3)
  notes             String?             @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("PurchaseOrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("PurchaseOrderApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, poNumber])
  @@index([branchId, status, createdAt])
  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Char(36)
  purchaseOrderId String   @map("purchase_order_id") @db.Char(36)
  itemId          String   @map("item_id") @db.Char(36)
  orderedQty      Decimal  @map("ordered_qty") @db.Decimal(18, 4)
  receivedQty     Decimal  @default(0) @map("received_qty") @db.Decimal(18, 4)
  unitCost        Decimal  @map("unit_cost") @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  @@unique([purchaseOrderId, itemId])
  @@index([itemId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id               String             @id @default(uuid()) @db.Char(36)
  organizationId   String             @map("organization_id") @db.Char(36)
  branchId         String             @map("branch_id") @db.Char(36)
  supplierId       String             @map("supplier_id") @db.Char(36)
  purchaseOrderId  String?            @map("purchase_order_id") @db.Char(36)
  receiptNumber    String             @map("receipt_number") @db.VarChar(80)
  supplierReference String?           @map("supplier_reference") @db.VarChar(150)
  status           GoodsReceiptStatus @default(DRAFT)
  receivedByUserId String             @map("received_by_user_id") @db.Char(36)
  receivedAt       DateTime           @default(now()) @map("received_at") @db.DateTime(3)
  postedAt         DateTime?          @map("posted_at") @db.DateTime(3)
  notes            String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy   User         @relation("GoodsReceiptReceiver", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  items        GoodsReceiptItem[]

  @@unique([organizationId, receiptNumber])
  @@index([branchId, status, receivedAt])
  @@index([supplierId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String   @id @default(uuid()) @db.Char(36)
  goodsReceiptId      String   @map("goods_receipt_id") @db.Char(36)
  purchaseOrderItemId String?  @map("purchase_order_item_id") @db.Char(36)
  itemId              String   @map("item_id") @db.Char(36)
  lotId               String?  @map("lot_id") @db.Char(36)
  lotNumber           String   @map("lot_number") @db.VarChar(120)
  expiryDate          DateTime? @map("expiry_date") @db.Date
  quantity            Decimal  @db.Decimal(18, 4)
  unitCost            Decimal  @map("unit_cost") @db.Decimal(18, 4)
  currency            String   @db.Char(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  goodsReceipt     GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  item             InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot              InventoryLot?     @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([itemId, lotNumber])
  @@index([lotId])
  @@map("goods_receipt_items")
}


model Equipment {
  id               String          @id @default(uuid()) @db.Char(36)
  organizationId   String          @map("organization_id") @db.Char(36)
  branchId         String          @map("branch_id") @db.Char(36)
  departmentId     String?         @map("department_id") @db.Char(36)
  analyzerId       String?         @unique @map("analyzer_id") @db.Char(36)
  assetId          String          @map("asset_id") @db.VarChar(100)
  name             String          @db.VarChar(220)
  manufacturer     String?         @db.VarChar(150)
  model            String?         @db.VarChar(150)
  serialNumber     String?         @map("serial_number") @db.VarChar(150)
  installationDate DateTime?       @map("installation_date") @db.Date
  warrantyUntil    DateTime?       @map("warranty_until") @db.Date
  serviceVendor    String?         @map("service_vendor") @db.VarChar(220)
  locationText     String?         @map("location_text") @db.VarChar(220)
  status           EquipmentStatus @default(ACTIVE)
  notes            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt    DateTime?       @map("deactivated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  analyzer     Analyzer?    @relation(fields: [analyzerId], references: [id], onDelete: Restrict)
  documents    EquipmentDocument[]
  maintenancePlans MaintenancePlan[]
  maintenanceEvents MaintenanceEvent[]
  calibrationEvents CalibrationEvent[]
  downtimeEvents EquipmentDowntime[]

  @@unique([organizationId, assetId])
  @@index([branchId, status])
  @@index([departmentId, status])
  @@map("equipment")
}

model EquipmentDocument {
  id          String   @id @default(uuid()) @db.Char(36)
  equipmentId String   @map("equipment_id") @db.Char(36)
  documentType String  @map("document_type") @db.VarChar(80)
  name        String   @db.VarChar(255)
  storageKey  String?  @map("storage_key") @db.VarChar(500)
  externalUrl String?  @map("external_url") @db.VarChar(1000)
  expiresAt   DateTime? @map("expires_at") @db.Date
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@index([equipmentId, documentType])
  @@index([expiresAt])
  @@map("equipment_documents")
}

model MaintenancePlan {
  id            String       @id @default(uuid()) @db.Char(36)
  equipmentId   String       @map("equipment_id") @db.Char(36)
  name          String       @db.VarChar(220)
  frequencyDays Int          @map("frequency_days")
  nextDueAt     DateTime     @map("next_due_at") @db.Date
  instructions  String?      @db.Text
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt DateTime?    @map("deactivated_at") @db.DateTime(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  events    MaintenanceEvent[]

  @@index([equipmentId, status, nextDueAt])
  @@map("maintenance_plans")
}

model MaintenanceEvent {
  id                String                 @id @default(uuid()) @db.Char(36)
  equipmentId       String                 @map("equipment_id") @db.Char(36)
  analyzerId        String?                @map("analyzer_id") @db.Char(36)
  maintenancePlanId String?                @map("maintenance_plan_id") @db.Char(36)
  maintenanceType   MaintenanceType        @map("maintenance_type")
  status            MaintenanceEventStatus @default(SCHEDULED)
  scheduledAt       DateTime?              @map("scheduled_at") @db.DateTime(3)
  startedAt         DateTime?              @map("started_at") @db.DateTime(3)
  completedAt       DateTime?              @map("completed_at") @db.DateTime(3)
  vendorEngineer    String?                @map("vendor_engineer") @db.VarChar(220)
  workPerformed     String?                @map("work_performed") @db.Text
  correctiveAction  String?                @map("corrective_action") @db.Text
  cost              Decimal?               @db.Decimal(18, 4)
  currency          String?                @db.Char(3)
  performedByUserId String?                @map("performed_by_user_id") @db.Char(36)
  createdAt         DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  equipment   Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  analyzer    Analyzer?       @relation(fields: [analyzerId], references: [id], onDelete: Restrict)
  plan        MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id], onDelete: Restrict)
  performedBy User?           @relation("MaintenancePerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([equipmentId, status, scheduledAt])
  @@index([analyzerId, completedAt])
  @@map("maintenance_events")
}

model CalibrationEvent {
  id                String            @id @default(uuid()) @db.Char(36)
  equipmentId       String            @map("equipment_id") @db.Char(36)
  analyzerId        String?           @map("analyzer_id") @db.Char(36)
  materialName      String?           @map("material_name") @db.VarChar(220)
  materialLot       String?           @map("material_lot") @db.VarChar(120)
  dueAt             DateTime?         @map("due_at") @db.Date
  performedAt       DateTime?         @map("performed_at") @db.DateTime(3)
  resultSummary     String?           @map("result_summary") @db.Text
  status            CalibrationStatus @default(DUE)
  performedByUserId String?           @map("performed_by_user_id") @db.Char(36)
  approvedByUserId  String?           @map("approved_by_user_id") @db.Char(36)
  approvedAt        DateTime?         @map("approved_at") @db.DateTime(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  analyzer    Analyzer? @relation(fields: [analyzerId], references: [id], onDelete: Restrict)
  performedBy User?     @relation("CalibrationPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  approvedBy  User?     @relation("CalibrationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([equipmentId, status, dueAt])
  @@index([analyzerId, status])
  @@map("calibration_events")
}

model EquipmentDowntime {
  id          String                  @id @default(uuid()) @db.Char(36)
  equipmentId String                  @map("equipment_id") @db.Char(36)
  analyzerId  String?                 @map("analyzer_id") @db.Char(36)
  status      EquipmentDowntimeStatus @default(OPEN)
  startedAt   DateTime                @map("started_at") @db.DateTime(3)
  endedAt     DateTime?               @map("ended_at") @db.DateTime(3)
  reason      String                  @db.VarChar(1000)
  impact      String?                 @db.VarChar(1000)
  resolution  String?                 @db.VarChar(1000)
  createdAt   DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  analyzer  Analyzer? @relation(fields: [analyzerId], references: [id], onDelete: Restrict)

  @@index([equipmentId, status, startedAt])
  @@index([analyzerId, status])
  @@map("equipment_downtime")
}

model QcMaterial {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(80)
  nameEn         String       @map("name_en") @db.VarChar(220)
  nameAr         String?      @map("name_ar") @db.VarChar(220)
  manufacturer   String?      @db.VarChar(150)
  levelName      String       @map("level_name") @db.VarChar(100)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lots QcLot[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("qc_materials")
}

model QcLot {
  id              String       @id @default(uuid()) @db.Char(36)
  organizationId  String       @map("organization_id") @db.Char(36)
  materialId      String       @map("material_id") @db.Char(36)
  inventoryLotId  String?      @map("inventory_lot_id") @db.Char(36)
  lotNumber       String       @map("lot_number") @db.VarChar(120)
  receivedAt      DateTime?    @map("received_at") @db.Date
  openedAt        DateTime?    @map("opened_at") @db.Date
  expiryDate      DateTime?    @map("expiry_date") @db.Date
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt   DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  material     QcMaterial    @relation(fields: [materialId], references: [id], onDelete: Restrict)
  inventoryLot InventoryLot? @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  targets      QcTarget[]

  @@unique([organizationId, materialId, lotNumber])
  @@index([materialId, status, expiryDate])
  @@index([inventoryLotId])
  @@map("qc_lots")
}

model QcTarget {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  qcLotId        String       @map("qc_lot_id") @db.Char(36)
  analyzerId     String       @map("analyzer_id") @db.Char(36)
  testId         String       @map("test_id") @db.Char(36)
  componentId    String?      @map("component_id") @db.Char(36)
  targetMean     Decimal      @map("target_mean") @db.Decimal(24, 8)
  targetSd       Decimal      @map("target_sd") @db.Decimal(24, 8)
  targetCv       Decimal?     @map("target_cv") @db.Decimal(18, 6)
  unitSnapshot   String?      @map("unit_snapshot") @db.VarChar(80)
  enabledRules   Json         @map("enabled_rules")
  qcValidHours   Int          @default(24) @map("qc_valid_hours")
  effectiveFrom  DateTime     @map("effective_from") @db.DateTime(3)
  effectiveTo    DateTime?    @map("effective_to") @db.DateTime(3)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  qcLot        QcLot        @relation(fields: [qcLotId], references: [id], onDelete: Restrict)
  analyzer     Analyzer     @relation(fields: [analyzerId], references: [id], onDelete: Restrict)
  test         LabTest      @relation(fields: [testId], references: [id], onDelete: Restrict)
  component    TestComponent? @relation(fields: [componentId], references: [id], onDelete: Restrict)
  results      QcResult[]
  violations   QcRuleViolation[]

  @@index([analyzerId, testId, componentId, status, effectiveFrom, effectiveTo])
  @@index([qcLotId, status])
  @@map("qc_targets")
}

model QcRun {
  id             String      @id @default(uuid()) @db.Char(36)
  organizationId String      @map("organization_id") @db.Char(36)
  branchId       String      @map("branch_id") @db.Char(36)
  analyzerId     String      @map("analyzer_id") @db.Char(36)
  status         QcRunStatus @default(PENDING)
  runAt          DateTime    @default(now()) @map("run_at") @db.DateTime(3)
  operatorUserId String      @map("operator_user_id") @db.Char(36)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  analyzer     Analyzer     @relation(fields: [analyzerId], references: [id], onDelete: Restrict)
  operator     User         @relation("QcRunOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
