  batchId             String? @map("batch_id") @db.Char(36)
  importRowId         String? @unique(map: "legacy_lineage_import_row_uq") @map("import_row_id") @db.Char(36)
  classification      LegacyLineageClassification @default(UNRESOLVED)
  targetType          String? @map("target_type") @db.VarChar(40)
  targetId            String? @map("target_id") @db.Char(36)
  revision            Int @default(0)
  reason              String? @db.VarChar(1000)
  createdByUserId     String @map("created_by_user_id") @db.Char(36)
  mappedByUserId      String? @map("mapped_by_user_id") @db.Char(36)
  reviewedByUserId    String? @map("reviewed_by_user_id") @db.Char(36)
  reviewedAt          DateTime? @map("reviewed_at") @db.DateTime(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batch CatalogImportBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  importRow CatalogImportRow? @relation(fields: [importRowId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceSha256, sourceTable, digestKeyId, rowDigest, occurrence], map: "legacy_lineage_source_unique")
  @@index([organizationId, sourceSha256, sourceTable, classification], map: "legacy_lineage_coverage_idx")
  @@index([batchId, importRowId], map: "legacy_lineage_staging_idx")
  @@index([targetType, targetId], map: "legacy_lineage_target_idx")
  @@map("legacy_catalog_row_lineage")
}

// Immutable-identity, effective-dated overlays for non-native-versioned
// catalog masters. Clinical ranges and prices use their own native history.
// A RECORDED revision is current only inside its effective date interval;
// historical reports must resolve by their own as-of context or snapshots.
model CatalogConfigurationRevision {
  id                    String @id @default(uuid()) @db.Char(36)
  organizationId        String @map("organization_id") @db.Char(36)
  branchId              String @map("branch_id") @db.Char(36)
  sourceBatchId         String @map("source_batch_id") @db.Char(36)
  sourceRowNumber       Int @map("source_row_number")
  entityType            String @map("entity_type") @db.VarChar(40)
  entityId              String @map("entity_id") @db.Char(36)
  revision              Int
  effectiveFrom         DateTime @map("effective_from") @db.DateTime(3)
  effectiveTo           DateTime? @map("effective_to") @db.DateTime(3)
  state                 CatalogConfigurationRevisionState @default(RECORDED)
  beforeSnapshot        Json @map("before_snapshot")
  afterSnapshot         Json @map("after_snapshot")
  originalDigest        String @map("original_digest") @db.Char(64)
  desiredDigest         String @map("desired_digest") @db.Char(64)
  planDigest            String @map("plan_digest") @db.Char(64)
  createdByUserId       String @map("created_by_user_id") @db.Char(36)
  clinicalSignerUserId  String @map("clinical_signer_user_id") @db.Char(36)
  financialSignerUserId String @map("financial_signer_user_id") @db.Char(36)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  cancelledAt           DateTime? @map("cancelled_at") @db.DateTime(3)
  cancelledByUserId     String? @map("cancelled_by_user_id") @db.Char(36)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceBatch CatalogImportBatch @relation(fields: [sourceBatchId], references: [id], onDelete: Restrict)
  creator User @relation("F2ConfigRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  clinicalSigner User @relation("F2ConfigRevisionClinician", fields: [clinicalSignerUserId], references: [id], onDelete: Restrict)
  financialSigner User @relation("F2ConfigRevisionFinancier", fields: [financialSignerUserId], references: [id], onDelete: Restrict)
  canceller User? @relation("F2ConfigRevisionCanceler", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  @@unique([sourceBatchId, sourceRowNumber], map: "f2_config_batch_row_uq")
  @@unique([organizationId, entityType, entityId, revision], map: "f2_config_master_revision_uq")
  @@index([organizationId, entityType, entityId, state, effectiveFrom], map: "f2_config_effective_lookup_idx")
  @@index([organizationId, branchId, effectiveFrom], map: "f2_config_branch_effective_idx")
  @@map("catalog_config_revisions")
}
